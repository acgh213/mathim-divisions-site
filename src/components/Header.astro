---
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Mathim Divisions home">
      <span class="brand-mark" aria-hidden="true"><span>M</span></span>
      <span class="brand-name">Mathim<br />Divisions<small>Independent / 001</small></span>
    </a>
    <button class="mobile-toggle" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">MENU +</button>
    <nav aria-label="Primary navigation">
      <ul class="nav-links" id="primary-navigation">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Overview</a></li>
        <li><a href="/services" aria-current={path === '/services' ? 'page' : undefined}>Divisions</a></li>
        <li><a href="/about" aria-current={path === '/about' ? 'page' : undefined}>Organization</a></li>
        <li><a href="/contact" class="nav-contact" aria-current={path === '/contact' ? 'page' : undefined}>Correspondence ↗</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
  const nav = document.querySelector<HTMLElement>('.nav-links');
  if (toggle && nav) {
    const close = () => {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      toggle.textContent = 'MENU +';
    };
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      toggle.textContent = open ? 'CLOSE −' : 'MENU +';
    });
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    window.addEventListener('keydown', event => { if (event.key === 'Escape') close(); });
  }
</script>