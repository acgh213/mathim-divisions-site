---
const divisions = [
  { n:'01', title:'Research & Development', description:'Independent experiments in useful intelligence, learning systems, and constrained computation.', href:'/services#research' },
  { n:'02', title:'Systems & Practice', description:'Technical operations, documentation, automation, and the craft of making complex systems understandable.', href:'/services#systems' },
  { n:'03', title:'Publications & Work', description:'Writing, tools, creative work, and projects that do not belong to a single discipline.', href:'/services#publications' },
];
---
<section class="divisions-section" id="divisions">
  <div class="container">
    <div class="section-topline"><span class="eyebrow">Organizational directory</span><span class="index">MD / 002</span></div>
    <div class="divisions-heading">
      <h2>Areas of<br />operation.</h2>
      <p>Multiple lines of work. One name. Each initiative is free to be exactly what it needs to be.</p>
    </div>
    <div class="division-list">
      {divisions.map(d => (
        <a class="division-row" href={d.href}>
          <span class="division-num mono">{d.n} /</span>
          <h3 class="division-name">{d.title}</h3>
          <p class="division-description">{d.description}</p>
          <span class="division-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>