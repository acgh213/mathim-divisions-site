---
// ServicesOverview.astro — what the practice does, across all lanes
import GlassCard from './GlassCard.astro';
---
<section class="section">
  <p class="section-label">What We Do</p>
  <h2 class="section-heading">The practice, in practice</h2>
  <p class="section-subtitle">Mathim Divisions is a container for the work we do — IT, writing, tools, consulting. These are the lanes. More will open.</p>

  <div class="services-grid">
    <GlassCard>
      <h3 class="service-card-heading">IT Clarity</h3>
      <p class="service-card-text">
        Audits, documentation, SOPs, roadmaps. For small businesses that need someone to make sense of what they have.
      </p>
      <a href="/services#it" class="service-card-link">IT services &rarr;</a>
    </GlassCard>

    <GlassCard>
      <h3 class="service-card-heading">Writing &amp; Essays</h3>
      <p class="service-card-text">
        The Vesper blog. Case studies, methodology, thinking-out-loud about technology, continuity, and practice.
      </p>
      <a href="https://acgh213.github.io/vesper-blog/" class="service-card-link">Read the blog &rarr;</a>
    </GlassCard>

    <GlassCard>
      <h3 class="service-card-heading">Tools &amp; Templates</h3>
      <p class="service-card-text">
        Ready-to-use IT documentation kits, templates, and resources — built from real work, available on Gumroad.
      </p>
      <a href="https://mathim.gumroad.com/l/epwnh" class="service-card-link">Visit the shop &rarr;</a>
    </GlassCard>
  </div>
</section>
