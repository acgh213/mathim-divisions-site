---
// services.astro — what we do page, multiple lanes
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
---

<BaseLayout
  title="What We Do"
  description="IT clarity, writing, tools, and consulting. Mathim Divisions is a practice with multiple lanes — here's what's available now."
>
  <section class="section" style="padding-top: 160px;">
    <p class="section-label">What We Do</p>
    <h1 class="section-heading">Multiple lanes, one practice</h1>
    <p class="section-subtitle">
      Mathim Divisions is a personal brand that can hold many kinds of work. These are the active lanes right now. More will open.
    </p>
  </section>

  <!-- IT Clarity -->
  <section class="section" id="it">
    <div class="section-divider" style="margin-bottom: 4rem;"></div>
    <p class="section-label">IT Clarity</p>
    <h2>Audits, documentation &amp; roadmaps</h2>
    <p>
      Small businesses that don't have dedicated IT staff still need to know what they have,
      what's broken, and what to do next. This is the core of the practice — clear, human-readable
      IT work delivered as documents you can actually use.
    </p>

    <div class="services-grid" style="margin-top: 2rem;">
      <GlassCard>
        <h3 class="service-card-heading">Light Audit</h3>
        <p class="service-card-text">
          A focused review of one area — M365 tenant health, device inventory, or backup
          verification. One report with findings and recommendations.
        </p>
        <p style="margin-top: 1rem; font-weight: 500;">Starting at $300</p>
      </GlassCard>

      <GlassCard>
        <h3 class="service-card-heading">Full Audit</h3>
        <p class="service-card-text">
          Complete environment scan: M365, devices, security, backups, network. Prioritized
          findings, immediate risks flagged, remediation roadmap.
        </p>
        <p style="margin-top: 1rem; font-weight: 500;">Starting at $1,200</p>
      </GlassCard>

      <GlassCard>
        <h3 class="service-card-heading">Compliance Readiness</h3>
        <p class="service-card-text">
          Audit plus compliance gap analysis against your framework — HIPAA, CMMC, or
          general security best practices. Documentation ready for review.
        </p>
        <p style="margin-top: 1rem; font-weight: 500;">Starting at $2,500</p>
      </GlassCard>
    </div>

    <p style="margin-top: 2rem;">
      Also available: <strong>documentation &amp; SOPs</strong> (starting at $300) and
      <strong>roadmaps &amp; strategy</strong> (starting at $500). Every engagement produces
      editable documents you keep — not a locked portal.
    </p>
  </section>

  <!-- Writing -->
  <section class="section" id="writing">
    <div class="section-divider" style="margin-bottom: 4rem;"></div>
    <p class="section-label">Writing</p>
    <h2>The Vesper Blog</h2>
    <p>
      Essays on technology, continuity, and practice — published regularly. Case studies from
      real engagements, thinking-out-loud about how IT work actually gets done, and explorations
      of what it means to build a practice around clarity.
    </p>
    <p style="margin-top: 1rem;">
      <a href="https://acgh213.github.io/vesper-blog/">Visit the blog &rarr;</a>
    </p>
  </section>

  <!-- Tools & Templates -->
  <section class="section" id="tools">
    <div class="section-divider" style="margin-bottom: 4rem;"></div>
    <p class="section-label">Tools &amp; Templates</p>
    <h2>Digital products on Gumroad</h2>
    <p>
      Ready-to-use IT documentation kits, SOP bundles, audit checklists, and policy templates —
      built from real engagements and available to download and adapt.
    </p>
    <p style="margin-top: 1rem;">
      The first product — the <strong>Small Business IT Audit Kit</strong> — is available now.
      <a href="https://mathim.gumroad.com/l/epwnh">Get it on Gumroad &rarr;</a>
    </p>
  </section>

  <!-- Contact -->
  <section class="section contact-section">
    <div class="section-divider" style="margin-bottom: 4rem;"></div>
    <p class="section-label">Next Step</p>
    <h2>Let's talk</h2>
    <p style="margin-bottom: 2rem;">
      Every engagement starts with a free conversation. No pitch, no pressure —
      just figuring out if we can help, in whatever lane makes sense.
    </p>
    <p>
      <a href="mailto:cassie@mathimdivisions.com" class="contact-email">cassie@mathimdivisions.com</a>
    </p>
  </section>
</BaseLayout>
