---
// contact.astro — full contact page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mathim Divisions. IT work, writing, collaboration — whatever the reason, start here."
>
  <section class="section" style="padding-top: 160px;">
    <p class="section-label">Contact</p>
    <h1 class="section-heading">Say hello</h1>
    <p class="section-subtitle">
      IT work, writing, collaboration, questions — whatever brings you here, start with an email.
    </p>
  </section>

  <section class="section contact-section">
    <h2>Email</h2>
    <p style="margin-bottom: 1rem;">
      The best way to reach me. I respond within one business day.
    </p>
    <p style="margin-bottom: 3rem;">
      <a href="mailto:cassie@mathimdivisions.com" class="contact-email">cassie@mathimdivisions.com</a>
    </p>

    <div class="section-divider" style="margin-bottom: 3rem;"></div>

    <h2>What to expect</h2>
    <p>
      If you're reaching out about IT work, every engagement starts with a free 30-minute
      conversation. We'll talk about what you have, what you need, and whether we're a good fit.
      If we're not, I'll tell you honestly — and point you in the right direction.
    </p>
    <p style="margin-top: 1rem;">
      If it's about writing, collaboration, or something else entirely — same thing. Start the conversation.
    </p>
  </section>
</BaseLayout>
