---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Correspondence and inquiries for Mathim Divisions.">
  <section class="interior-hero">
    <div class="container">
      <div class="interior-ref label"><span>Communications / 04</span><span>MD–COMMS / 2026</span></div>
      <h1>General<br/><em>correspondence.</em></h1>
      <p>Research, technical work, publishing, and proposals that do not fall into an existing category.</p>
    </div>
  </section>
  <section class="editorial-section">
    <div class="container">
      <div class="section-heading"><span class="section-index">04</span><h2>Correspondence desk</h2></div>
      <div class="contact-details">
        <h2>Begin with a<br/>conversation.</h2>
        <div>
          <p>For inquiries, collaboration, technical work, publications, or simply an idea worth discussing.</p>
          <p>Send a short note with enough context to understand the project. Correspondence is handled directly.</p>
          <a href="mailto:cassie@mathimdivisions.com" class="contact-email">cassie@mathimdivisions.com ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>