---
// contact.astro — full contact page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mathim Divisions. Every engagement starts with a conversation."
>
  <section class="section" style="padding-top: 160px;">
    <p class="section-label">Contact</p>
    <h1 class="section-heading">Say hello</h1>
    <p class="section-subtitle">
      Whether you're ready to bring clarity to your IT environment or just want to
      ask a question, start here.
    </p>
  </section>

  <section class="section contact-section">
    <h2>Email</h2>
    <p style="margin-bottom: 1rem;">
      The best way to reach us. We respond within one business day.
    </p>
    <p style="margin-bottom: 3rem;">
      <a href="mailto:cassie@mathimdivisions.com" class="contact-email">cassie@mathimdivisions.com</a>
    </p>

    <div class="section-divider" style="margin-bottom: 3rem;"></div>

    <h2>What to expect</h2>
    <p>
      Every engagement starts with a free 30-minute conversation. We'll talk about what
      you have, what you need, and whether Mathim Divisions is a good fit. If it's not,
      we'll tell you honestly — and point you in the right direction.
    </p>
  </section>
</BaseLayout>
